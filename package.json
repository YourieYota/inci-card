{
  "name": "inci-card",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "cross-env DB_PROVIDER=sqlite DATABASE_URL=file:./data/inci-card.db next dev",
    "build": "next build",
    "build:local": "cross-env DB_PROVIDER=sqlite DATABASE_URL=file:./data/inci-card.db next build",
    "start": "next start",
    "start:local": "cross-env DB_PROVIDER=sqlite DATABASE_URL=file:./data/inci-card.db next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:local:migrate": "cross-env DATABASE_URL=file:./data/inci-card.db prisma migrate dev --config prisma.config.sqlite.ts --schema prisma/schema.sqlite.prisma",
    "db:local:studio": "cross-env DATABASE_URL=file:./data/inci-card.db prisma studio --config prisma.config.sqlite.ts --schema prisma/schema.sqlite.prisma"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "cross-env": "^7.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^1.20.0",
    "next": "16.2.9",
    "next-auth": "^4.24.14",
    "next-themes": "^0.4.6",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-qr-code": "^2.2.0",
    "react-rnd": "^10.5.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
