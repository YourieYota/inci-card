// Schema LibSQL/SQLite — Mode Installation Locale (.exe)
// Utilisé quand DB_PROVIDER=sqlite (Prisma 7 : LibSQL = SQLite via @prisma/adapter-libsql)
// Les champs Json sont stockés en String (SQLite ne supporte pas Json natif)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- FILE DE SYNC (mutations en attente d'envoi au serveur central) ---
model SyncQueue {
  id          String   @id
  type        String
  payload     String   // JSON stringifié (SQLite = String)
  timestamp   BigInt
  description String
  retryCount  Int      @default(0)
  status      String   @default("pending") // pending | processing | failed | synced
  createdAt   DateTime @default(now())
}

// --- CURSEUR DE SYNC DESCENDANTE ---
model SyncCursor {
  tableName     String   @id
  lastSyncedAt  DateTime @default(now())
}

// --- MODELE ROLES DYNAMIQUES ---
model CustomRole {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  color       String   @default("#6366f1")
  isSystem    Boolean  @default(false)
  permissions String   @default("{}") // Json → String en SQLite
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Int      @default(0)
}

// Utilisateurs de l'application
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  login        String?  @unique
  passwordHash String
  name         String
  firstName    String?
  phone        String?
  role         String   @default("OPERATEUR")
  createdAt    DateTime @default(now())
  version      Int      @default(0)
}

// Entreprises Clientes
model Company {
  id                 String   @id @default(uuid())
  name               String   @unique
  identifierPrefix   String?
  isLocked           Boolean  @default(false)
  isLaserEnabled     Boolean  @default(false)
  protectAppModified Boolean  @default(true)
  createdAt          DateTime @default(now())
  version            Int      @default(0)

  employees       Employee[]
  templates       CardTemplate[]
  cardFormats     CardFormat[]
  cardCategories  CardCategory[]
  physicalTypes   CardPhysicalType[]
  documentTypes   CardDocumentType[]
  deliveryBatches DeliveryBatch[]
}

// Employés des entreprises clientes
model Employee {
  id               String   @id @default(uuid())

  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  dynamicData      String   // Json → String en SQLite
  uniqueIdentifier String

  photoUrl         String?
  photoHash        String?
  photoConflict    Boolean  @default(false)
  enrollmentNumber String?
  cardNumber       String?

  status           String   @default("A_ENROLER")
  isLocked         Boolean  @default(false)
  isBlocked        Boolean  @default(false)
  appModified      Boolean  @default(false)
  printCount       Int      @default(0)
  version          Int      @default(0) // Pour la résolution de conflits

  printedAt        DateTime?
  enrolledBy       String?
  printedBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  deliveryBatchId  String?
  deliveryBatch    DeliveryBatch? @relation(fields: [deliveryBatchId], references: [id], onDelete: SetNull)
  printJobs        PrintJob[]

  @@unique([companyId, uniqueIdentifier])
}

// Modèles de conception (Studio Drag & Drop)
model CardTemplate {
  id            String   @id @default(uuid())

  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  type          String   @default("BADGE")

  categoryId    String?
  category      CardCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  width         Int      @default(324)
  height        Int      @default(204)
  backgroundUrl String?

  layoutConfig  String   // Json → String en SQLite
  version       Int      @default(0)

  @@unique([companyId, type, categoryId])
}

model CardFormat {
  id          String         @id @default(uuid())
  name        String
  width       Float          @default(85.6)
  height      Float          @default(53.98)
  unit        String         @default("mm")
  companyId   String?
  company     Company?       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  categories  CardCategory[]

  @@unique([companyId, name])
}

model CardCategory {
  id               String         @id @default(uuid())
  name             String
  slug             String
  color            String         @default("#6366f1")
  description      String?
  validityValue    Int?           @default(1)
  validityUnit     String?        @default("YEAR")
  formatId         String
  format           CardFormat     @relation(fields: [formatId], references: [id], onDelete: Restrict)
  companyId        String?
  company          Company?       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  templates        CardTemplate[]
  documentTypeSlug String?        @default("")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([companyId, name])
  @@unique([companyId, slug])
}

model CardPhysicalType {
  id          String   @id @default(uuid())
  name        String
  slug        String
  description String?
  cardCode    String   @default("")
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, name])
  @@unique([companyId, slug])
}

model DeliveryBatch {
  id              String   @id @default(uuid())
  batchNumber     String?  @unique
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status          String   @default("PREPARE")
  employees       Employee[]
  shippedAt       DateTime?
  deliveredAt     DateTime?
  signedProof     String?
  signedProofName String?
  signedProofType String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
}

model CardDocumentType {
  id          String   @id @default(uuid())
  name        String
  slug        String
  description String?
  cardCode    String   @default("")
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, name])
  @@unique([companyId, slug])
}

model PrintJob {
  id             String   @id @default(uuid())

  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  cardNumber     String
  templateType   String
  categoryId     String?
  physicalTypeId String?

  isReprint      Boolean  @default(false)
  reprintReason  String?

  printedBy      String
  printedAt      DateTime @default(now())

  createdAt      DateTime @default(now())
}
