generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model CustomRole {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  color       String   @default("#6366f1")
  isSystem    Boolean  @default(false)
  permissions Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  firstName    String?
  login        String?  @unique
  phone        String?
  role         String   @default("OPERATEUR")
}

model Company {
  id               String             @id @default(uuid())
  name             String             @unique
  createdAt        DateTime           @default(now())
  identifierPrefix String?
  isLocked         Boolean            @default(false)
  isLaserEnabled   Boolean            @default(false)
  protectAppModified Boolean          @default(true)
  cardCategories   CardCategory[]
  documentTypes    CardDocumentType[]
  cardFormats      CardFormat[]
  physicalTypes    CardPhysicalType[]
  templates        CardTemplate[]
  deliveryBatches  DeliveryBatch[]
  employees        Employee[]
}

model Employee {
  id               String         @id @default(uuid())
  companyId        String
  dynamicData      Json
  uniqueIdentifier String
  photoUrl         String?
  status           String         @default("A_ENROLER")
  printedAt        DateTime?
  createdAt        DateTime       @default(now())
  enrollmentNumber String?
  photoConflict    Boolean        @default(false)
  photoHash        String?
  deliveryBatchId  String?
  updatedAt        DateTime       @default(now()) @updatedAt
  enrolledBy       String?
  printedBy        String?
  cardNumber       String?
  isBlocked        Boolean        @default(false)
  isLocked         Boolean        @default(false)
  printCount       Int            @default(0)
  appModified      Boolean        @default(false)
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deliveryBatch    DeliveryBatch? @relation(fields: [deliveryBatchId], references: [id])
  printJobs        PrintJob[]

  @@unique([companyId, uniqueIdentifier])
}

model CardTemplate {
  id            String        @id @default(uuid())
  companyId     String
  width         Int           @default(324)
  height        Int           @default(204)
  backgroundUrl String?
  layoutConfig  Json
  categoryId    String?
  type          String        @default("BADGE")
  category      CardCategory? @relation(fields: [categoryId], references: [id])
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, type, categoryId])
}

model CardFormat {
  id         String         @id @default(uuid())
  name       String
  width      Float          @default(85.6)
  height     Float          @default(53.98)
  unit       String         @default("mm")
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  companyId  String?
  categories CardCategory[]
  company    Company?       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
}

model CardCategory {
  id            String         @id @default(uuid())
  name          String
  slug          String
  color         String         @default("#6366f1")
  description   String?
  formatId      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  companyId     String?
  validityUnit  String?        @default("YEAR")
  validityValue Int?           @default(1)
  company       Company?       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  format        CardFormat     @relation(fields: [formatId], references: [id])
  templates     CardTemplate[]

  @@unique([companyId, name])
  @@unique([companyId, slug])
}

model CardPhysicalType {
  id          String   @id @default(uuid())
  name        String
  slug        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  companyId   String?
  cardCode    String   @default("")
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@unique([companyId, slug])
}

model DeliveryBatch {
  id          String     @id @default(uuid())
  companyId   String
  status      String     @default("PREPARE")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt
  batchNumber String?    @unique
  deliveredAt DateTime?
  shippedAt   DateTime?
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees   Employee[]
}

model CardDocumentType {
  id          String   @id @default(uuid())
  name        String
  slug        String
  description String?
  companyId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cardCode    String   @default("")
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@unique([companyId, slug])
}

model PrintJob {
  id             String   @id @default(uuid())
  employeeId     String
  cardNumber     String
  templateType   String
  categoryId     String?
  physicalTypeId String?
  isReprint      Boolean  @default(false)
  reprintReason  String?
  printedBy      String
  printedAt      DateTime @default(now())
  createdAt      DateTime @default(now())
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}
